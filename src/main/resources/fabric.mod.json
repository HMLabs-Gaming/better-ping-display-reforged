{
  "schemaVersion": 1,
  "id": "betterpingdisplay",
  "version": "${version}",

  "name": "Better Ping Display Reforged",
  "description": "A continuation of Better Ping Display that shows ping values in the player list.",
  "authors": ["Quintinity"],

  "contact": {
    "homepage": "https://gaming.hmlabs.eu/projects/mods/better-ping-display-reforged/",
    "sources": "https://github.com/henrymmey/better-ping-display-reforged",
    "issues": "https://github.com/HMLabs-Gaming/issues/issues"
  },

  "license": "MIT",
  "icon": "assets/betterpingdisplay/icon.png",

  "environment": "client",
  "entrypoints": {
    "main": ["com.vladmarica.betterpingdisplay.BetterPingDisplayMod"],
    "modmenu": ["com.vladmarica.betterpingdisplay.integ.ModMenuIntegration"]
  },
  "mixins": ["betterpingdisplay.mixins.json"],

  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "${minecraft_version}"
  },

  "suggests": {
    "yet_another_config_lib_v3": ">=3.9.7+26.2-fabric"
  },

  "custom": {
    "modmenu": {
      "update_checker": false
    }
  }
}
